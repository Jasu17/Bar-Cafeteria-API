meta {
  name: create
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/subcategories
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "Cafés",
    "description": "Variedades de café",
    "categoryId": "{{categoryId}}"
  }
}

script:post-response {
  const id = res.body.id;
  bru.setEnvVar("subcategoryId", id);
}

settings {
  encodeUrl: true
  timeout: 0
}
