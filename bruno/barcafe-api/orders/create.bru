meta {
  name: create
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/orders
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "items": [
      {
        "productId": "{{productId}}",
        "quantity": 2
      }
    ]
  }
}

script:post-response {
  const id = res.body.id;
  bru.setEnvVar("orderId", id);
}

settings {
  encodeUrl: true
  timeout: 0
}
