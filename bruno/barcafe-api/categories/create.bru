meta {
  name: create
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/categories
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "Bebidas Calientes",
    "description": "Cafés y tés"
  }
}

script:post-response {
  const id = res.body.id;
  bru.setEnvVar("categoryId", id);
}

settings {
  encodeUrl: true
  timeout: 0
}
